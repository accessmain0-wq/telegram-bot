# warn tracking
warns = {}

# /warn
async def warn(update, context):
    if not is_admin(update.message.from_user.id):
        await update.message.reply_text("❌ Admin သာ သုံးနိုင်သည်။")
        return
    if not update.message.reply_to_message:
        await update.message.reply_text("⚠️ Warn လုပ်မည့် message ကို reply လုပ်ပါ။")
        return
    user = update.message.reply_to_message.from_user
    uid = user.id
    warns[uid] = warns.get(uid, 0) + 1
    if warns[uid] >= 3:
        await context.bot.ban_chat_member(update.effective_chat.id, uid)
        await update.message.reply_text(f"🚫 {user.first_name} — 3 ကြိမ် warn ရပြီ၊ auto ban လုပ်လိုက်သည်။")
        warns[uid] = 0
    else:
        await update.message.reply_text(
            f"⚠️ {user.first_name} သတိပေးသည်။ ({warns[uid]}/3)\n3 ကြိမ်ပြည့်ရင် auto ban ဖြစ်မည်။"
        )

# /info
async def info(update, context):
    if update.message.reply_to_message:
        user = update.message.reply_to_message.from_user
    else:
        user = update.message.from_user
    await update.message.reply_text(
        f"👤 User Info\n"
        f"နာမည်: {user.first_name}\n"
        f"Username: @{user.username or 'မရှိ'}\n"
        f"ID: {user.id}\n"
        f"Warns: {warns.get(user.id, 0)}/3"
    )

# AI Auto Reply
async def reply(update, context):
    user_msg = update.message.text
    await context.bot.send_chat_action(
        chat_id=update.effective_chat.id,
        action="typing"
    )
    try:
        response = client.chat.completions.create(
            model="Meta-Llama-3.1-8B-Instruct",
            messages=[
                {"role": "system", "content": "မြန်မာဘာသာဖြင့် ဖြေပါ။"},
                {"role": "user", "content": user_msg}
            ]
        )
        answer = response.choices[0].message.content
    except Exception:
        answer = "❌ အမှားဖြစ်သွားတယ်၊ နောက်မှ ထပ်ကြိုးစားပါ။"
    await update.message.reply_text(answer)

# App build
app = Application.builder().token(TELEGRAM_TOKEN).build()
app.add_handler(CommandHandler("start", start))
app.add_handler(CommandHandler("ban", ban))
app.add_handler(CommandHandler("kick", kick))
app.add_handler(CommandHandler("mute", mute))
app.add_handler(CommandHandler("unmute", unmute))
app.add_handler(CommandHandler("warn", warn))
app.add_handler(CommandHandler("info", info))
app.add_handler(MessageHandler(filters.TEXT & ~filters.COMMAND, reply))
print("Bot စတင်နေပြီ... ✅")
app.run_polling()
